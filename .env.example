# Gemini
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# Swytchcode
# Set to true to route all API calls through the Swytchcode layer.
USE_SWYTCHCODE=false

# GitHub
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/your-repo-name

# Jira
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=DEMO

# Netlify
# Site configuration -> Build & deploy -> Build hooks -> copy the full URL.
NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxxxxxxxxxxxxxx

# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
# The page ID is the 32-char hex at the end of the Notion page URL.
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
